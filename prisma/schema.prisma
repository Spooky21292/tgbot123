generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 String              @id @default(cuid())
  name               String
  email              String              @unique
  passwordHash       String
  ageGroup           String
  role               String              @default("user")
  activePlan         String?
  planExpiresAt      DateTime?
  promoCodeUsed      String?
  familyOwnerId      String?
  createdAt          DateTime            @default(now())
  progress           UserProgress[]
  quizResults        QuizResult[]
  webinarEnrollments WebinarEnrollment[]
  demoAccount        DemoAccount?
  familyOwner        User?               @relation("FamilyMembers", fields: [familyOwnerId], references: [id])
  familyMembers      User[]              @relation("FamilyMembers")
}

model Course {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String
  ageGroup    String
  level       String
  coverImage  String
  isPublished Boolean  @default(false)
  isPremium   Boolean  @default(false)
  createdAt   DateTime @default(now())
  lessons     Lesson[]
}

model Lesson {
  id              String         @id @default(cuid())
  courseId        String
  title           String
  description     String
  videoUrl        String
  content         String
  order           Int
  durationMinutes Int
  createdAt       DateTime       @default(now())
  course          Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  quiz            Quiz?
  progress        UserProgress[]

  @@unique([courseId, order])
}

model Quiz {
  id        String         @id @default(cuid())
  lessonId  String         @unique
  title     String
  lesson    Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions QuizQuestion[]
  results   QuizResult[]
}

model QuizQuestion {
  id            String @id @default(cuid())
  quizId        String
  question      String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctAnswer String
  quiz          Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model UserProgress {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  completed   Boolean  @default(false)
  completedAt DateTime?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model QuizResult {
  id        String   @id @default(cuid())
  userId    String
  quizId    String
  score     Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model Webinar {
  id          String              @id @default(cuid())
  title       String
  description String
  speaker     String
  date        DateTime
  meetingUrl  String
  isPublished Boolean             @default(false)
  enrollments WebinarEnrollment[]
}

model WebinarEnrollment {
  id        String   @id @default(cuid())
  userId    String
  webinarId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  webinar   Webinar  @relation(fields: [webinarId], references: [id], onDelete: Cascade)

  @@unique([userId, webinarId])
}

model BotFeature {
  id          String @id @default(cuid())
  title       String
  description String
  icon        String
}

model Article {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String
  content     String
  category    String
  createdAt   DateTime @default(now())
  isPublished Boolean  @default(false)
}

model ContactRequest {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}

model DemoAccount {
  id             String     @id @default(cuid())
  userId         String     @unique
  balance        Float
  initialBalance Float
  currency       String     @default("RUB")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  positions      Position[]
  trades         Trade[]
}

model Asset {
  id        String     @id @default(cuid())
  symbol    String     @unique
  name      String
  type      String
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  positions Position[]
  trades    Trade[]
}

model Position {
  id           String      @id @default(cuid())
  accountId    String
  assetId      String
  quantity     Float
  averagePrice Float
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  account      DemoAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  asset        Asset       @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([accountId, assetId])
}

model Trade {
  id          String      @id @default(cuid())
  accountId   String
  assetId     String
  side        String
  quantity    Float
  price       Float
  total       Float
  realizedPnl Float?
  createdAt   DateTime    @default(now())
  account     DemoAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  asset       Asset       @relation(fields: [assetId], references: [id], onDelete: Cascade)
}
